---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "TreeCareService",
          "@id": "https://treesurgeondurham.co.uk/#service",
          name: "Tree Surgeon Durham",
          url: "https://treesurgeondurham.co.uk/",
          image: "https://treesurgeondurham.co.uk/logo.png",
          description: "Tree felling, removal, stump grinding and pruning across Durham and County Durham.",
          areaServed: [
            { "@type": "City", name: "Durham" },
            { "@type": "City", name: "Chester-le-Street" },
            { "@type": "City", name: "Consett" },
            { "@type": "City", name: "Bishop Auckland" },
            { "@type": "City", name: "Spennymoor" },
            { "@type": "City", name: "Stanley" }
          ],
          address: {
            "@type": "PostalAddress",
            addressLocality: "Durham",
            addressRegion: "County Durham",
            addressCountry: "GB"
          },
          geo: { "@type": "GeoCoordinates", latitude: 54.7753, longitude: -1.5849 },
          priceRange: "££",
          openingHours: "Mo-Sa 08:00-18:00"
        },
        {
          "@type": "Organization",
          "@id": "https://treesurgeondurham.co.uk/#organization",
          name: "Tree Surgeon Durham",
          url: "https://treesurgeondurham.co.uk/",
          areaServed: { "@type": "City", name: "Durham" }
        },
        {
          "@type": "WebSite",
          "@id": "https://treesurgeondurham.co.uk/#website",
          url: "https://treesurgeondurham.co.uk/",
          name: "Tree Surgeon Durham",
          publisher: { "@id": "https://treesurgeondurham.co.uk/#organization" }
        },
        {
          "@type": "WebPage",
          "@id": new URL(Astro.url.pathname, Astro.site).href,
          url: new URL(Astro.url.pathname, Astro.site).href,
          name: title,
          description,
          isPartOf: { "@id": "https://treesurgeondurham.co.uk/#website" }
        }
      ]
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <img class="brand-mark" src="/logo.png" alt="Tree Surgeon Durham logo" width="40" height="40" />
          <span class="brand-name">Tree Surgeon Durham</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#services">Services</a>
          <a href="/areas/">Areas</a>
          <a href="/#faq">FAQ</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-brand">Tree Surgeon Durham</p>
          <p>Tree felling, removal and care across County Durham.</p>
        </div>
        <div>
          <p class="footer-heading">Contact</p>
          <p><a href="/contact/">Send an enquiry</a></p>
        </div>
        <div>
          <p class="footer-heading">Links</p>
          <p><a href="/#services">Services</a></p>
          <p><a href="/areas/">Areas we cover</a></p>
          <p><a href="/#faq">FAQ</a></p>
          <p><a href="/contact/">Contact</a></p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Tree Surgeon Durham. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
