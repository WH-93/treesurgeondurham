---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://treesurgeondurham.co.uk/#organization",
          name: "Tree Surgeon Durham",
          url: "https://treesurgeondurham.co.uk/",
          areaServed: { "@type": "City", name: "Durham" }
        },
        {
          "@type": "WebSite",
          "@id": "https://treesurgeondurham.co.uk/#website",
          url: "https://treesurgeondurham.co.uk/",
          name: "Tree Surgeon Durham",
          publisher: { "@id": "https://treesurgeondurham.co.uk/#organization" }
        },
        {
          "@type": "WebPage",
          "@id": new URL(Astro.url.pathname, Astro.site).href,
          url: new URL(Astro.url.pathname, Astro.site).href,
          name: title,
          description,
          isPartOf: { "@id": "https://treesurgeondurham.co.uk/#website" }
        }
      ]
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">TD</span>
          <span class="brand-name">Tree Surgeon Durham</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#services">Services</a>
          <a href="/#how-it-works">How it works</a>
          <a href="/#faq">FAQ</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-brand">Tree Surgeon Durham</p>
          <p>Tree felling, removal and care across County Durham.</p>
        </div>
        <div>
          <p class="footer-heading">Contact</p>
          <p><a href="mailto:enquiries@treefellingnearme.co.uk">enquiries@treefellingnearme.co.uk</a></p>
          <p><a href="/contact/">Send an enquiry</a></p>
        </div>
        <div>
          <p class="footer-heading">Links</p>
          <p><a href="/#services">Services</a></p>
          <p><a href="/#faq">FAQ</a></p>
          <p><a href="/contact/">Contact</a></p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Tree Surgeon Durham. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
