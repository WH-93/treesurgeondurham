---
import Layout from '../../layouts/Layout.astro';

const title = 'Tree Surgery Guides | Tree Surgeon Durham';
const description = 'Practical guides on tree felling costs, stump grinding prices, tree preservation orders, ash dieback and storm damage in County Durham.';
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <h1>Tree Surgery Guides</h1>
      <p>Straight answers on costs, permissions and looking after trees in County Durham.</p>
    </div>
  </section>

  <section class="page-main">
    <div class="container">
      <div class="services-grid">
        <a class="service-card" href="/guides/tree-felling-cost/">
          <h3>How much does tree felling cost in Durham?</h3>
          <p>Typical prices for felling, sectional dismantling and removal, with the factors that move the price.</p>
        </a>
        <a class="service-card" href="/guides/stump-grinding-cost/">
          <h3>How much does stump grinding cost?</h3>
          <p>Stump grinding prices by size, and what to expect after the job.</p>
        </a>
        <a class="service-card" href="/guides/tree-preservation-orders/">
          <h3>Tree Preservation Orders and Conservation Areas</h3>
          <p>Do you need permission to fell a tree in Durham? TPOs, Conservation Areas and the rules that apply.</p>
        </a>
        <a class="service-card" href="/guides/ash-dieback/">
          <h3>Ash dieback in County Durham</h3>
          <p>What ash dieback is, what it looks like, and when a tree needs to come down.</p>
        </a>
        <a class="service-card" href="/guides/storm-damage/">
          <h3>Storm damage: what to do first</h3>
          <p>Making a damaged tree safe, what not to do, and when to call a tree surgeon.</p>
        </a>
        <a class="service-card" href="/guides/common-trees-county-durham/">
          <h3>Common trees in County Durham gardens</h3>
          <p>Sycamore, ash, beech, leylandii and the rest: how they grow, and the problems they cause.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
