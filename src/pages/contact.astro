---
import Layout from '../layouts/Layout.astro';

const title = 'Contact | Tree Surgeon Durham';
const description = 'Contact Tree Surgeon Durham for a free inspection and written quote. Tree felling, removal and care across Durham and County Durham. Call 07503 512953.';
---

<Layout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <h1>Contact us</h1>
      <p>Tell us where the tree is, what is nearby, and whether access is restricted. We will get back to you with a free written quote.</p>
    </div>
  </section>

  <section class="page-main">
    <div class="container contact-grid">
      <div class="contact-details">
        <h2>Get in touch</h2>
        <p>Call: <a href="tel:07503512953"><strong>07503 512953</strong></a></p>
        <p>Email: <a href="mailto:enquiries@treefellingnearme.co.uk">enquiries@treefellingnearme.co.uk</a></p>
        <p>Covering Durham city and County Durham, including Chester-le-Street, Spennymoor, Bishop Auckland and Consett.</p>
        <p>Free inspection, fixed written quote, no obligation. We do not charge for quotes.</p>
      </div>

      <form class="contact-form" action="https://formsubmit.co/enquiries@treefellingnearme.co.uk" method="POST">
        <input type="hidden" name="_subject" value="New enquiry from treesurgeondurham.co.uk" />
        <input type="hidden" name="_template" value="box" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" style="display:none" />

        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />

        <label for="phone">Phone number</label>
        <input type="tel" id="phone" name="phone" required />

        <label for="email">Email (optional)</label>
        <input type="email" id="email" name="email" />

        <label for="postcode">Postcode</label>
        <input type="text" id="postcode" name="postcode" />

        <label for="service">What do you need?</label>
        <select id="service" name="service">
          <option value="tree felling">Tree felling</option>
          <option value="crown reduction / thinning">Crown reduction / thinning</option>
          <option value="stump grinding">Stump grinding</option>
          <option value="hedge trimming / removal">Hedge trimming / removal</option>
          <option value="site clearance">Site clearance</option>
          <option value="storm damage / emergency">Storm damage / emergency</option>
          <option value="other">Something else</option>
        </select>

        <label for="message">Details</label>
        <textarea id="message" name="message" placeholder="Location, what is nearby, access restrictions." required></textarea>

        <button class="btn btn-primary" type="submit">Send enquiry</button>
        <p class="form-note">We reply within one working day. Your details are only used to respond to your enquiry.</p>
      </form>
    </div>
  </section>
</Layout>
